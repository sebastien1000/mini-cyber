# Copie ce fichier en .env pour personnaliser la config en local.
# Le fichier .env n'est JAMAIS commité (voir .gitignore) : c'est là qu'iraient
# les vrais secrets en production.

# Active/désactive le mode debug de Flask (rechargement auto, pages d'erreur détaillées)
FLASK_DEBUG=true

# Utilisée par Flask pour signer les sessions/cookies. À changer en production.
SECRET_KEY=dev
